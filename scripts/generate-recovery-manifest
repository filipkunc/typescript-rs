#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
tsgo_repo=${1:-${TSGO_REPO:-}}
if [[ -z "$tsgo_repo" ]]; then
  echo "usage: $0 <typescript-go-checkout>" >&2
  exit 2
fi

tsgo_repo=$(cd "$tsgo_repo" && pwd)
expected_revision=$(grep -Ev '^[[:space:]]*(#|$)' "$repo_root/tests/tsgo-reference.txt")
actual_revision=$(git -C "$tsgo_repo" rev-parse HEAD)
if [[ "$actual_revision" != "$expected_revision" ]]; then
  echo "TypeScript-Go revision mismatch: expected $expected_revision, found $actual_revision" >&2
  exit 2
fi

probe_dir=$(mktemp -d "$tsgo_repo/.tsrs-recovery-probe.XXXXXX")
trap 'rm -rf -- "$probe_dir"' EXIT
cp "$repo_root/tools/tsgo-recovery-probe/main.go" "$probe_dir/main.go"

go_command=${GO:-go}
(
  cd "$tsgo_repo"
  "$go_command" run "$probe_dir/main.go" \
    --cases "$repo_root/tests/recovery-manifest/cases" \
    --revision "$expected_revision" \
    --output "$repo_root/tests/recovery-manifest/typescript-go.json"
)
